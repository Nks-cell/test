# MediCare Pro Environment Configuration (Sample Placeholders Only)

# Server Configuration
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Supabase Configuration (Recommended for Supabase Deployment)
# -----------------------------------------------------------------------------
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_supabase_anon_key_placeholder"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_supabase_service_role_key_placeholder"

# Client-facing Vite Supabase variables (Synced with above)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_supabase_anon_key_placeholder"

# Direct Supabase PostgreSQL Connection String (Optional for Prisma/Drizzle)
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# -----------------------------------------------------------------------------
# MongoDB Connection String (Alternative / Fallback)
# -----------------------------------------------------------------------------
# If Supabase is not configured, the app will try MongoDB Atlas, or run in-memory.
MONGODB_URI="mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/medicare_pro?retryWrites=true&w=majority"

# Authentication Secrets
JWT_SECRET="medicare_pro_secure_jwt_token_secret_replace_in_production_min32chars"
JWT_EXPIRES_IN="24h"

# Default Initial Administrator Setup
ADMIN_DEFAULT_EMAIL="admin@medicarepro.demo"
ADMIN_DEFAULT_PASSWORD="ClinicAdmin2026!"

# Notification Integration Abstraction
# Supported modes: 'demo' (safe simulated log with provider audit), 'sendgrid', 'twilio_whatsapp'
NOTIFICATION_PROVIDER="demo"
SENDGRID_API_KEY="SG.your_sendgrid_api_key_placeholder"
SENDGRID_FROM_EMAIL="appointments@medicarepro.demo"

TWILIO_ACCOUNT_SID="AC_your_twilio_account_sid_placeholder"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_placeholder"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Host Application URL
APP_URL="http://localhost:3000"
